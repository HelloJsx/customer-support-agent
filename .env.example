# ============================================
# AI provider (OpenAI compatible endpoint)
# DeepSeek example: https://api.deepseek.com/v1
# OpenAI example: https://api.openai.com/v1
# ============================================
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_CHAT_MODEL=deepseek-chat
AI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: a separate embedding endpoint when the chat provider has no embedding API
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=

# ============================================
# Infrastructure (docker compose)
# ============================================
DB_NAME=customer_support
DB_USER=support
DB_PASSWORD=support
DB_PORT=5432
REDIS_PORT=6379

# RAG vector store: none | pgvector
RAG_VECTOR_STORE=pgvector
# Chat memory: in-memory | redis
MEMORY_STORE=redis
